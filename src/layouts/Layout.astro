---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  active?: 'home' | 'about' | 'coaching' | '';
  image?: string;
  noindex?: boolean;
}

const { title, description, active = '', image = '/images/og-image.jpg', noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Richard Ritmeijer',
  url: 'https://bridgeperformance.coach',
  jobTitle: 'Bridge coach & professional',
  award: ['World Bridge Champion, Mixed Teams (2016)', 'Champions Cup (2017)', 'World International Master'],
  knowsAbout: 'Bridge (card game)',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Bridge Performance" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1100" />
  <meta property="og:image:height" content="578" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <Analytics />
</head>
<body>
  <nav>
    <a class="nav-brand" href="/">Bridge Performance</a>
    <div class="nav-links">
      <a class:list={["nav-link", { active: active === 'home' }]} href="/">Home</a>
      <a class:list={["nav-link", { active: active === 'about' }]} href="/about/">About</a>
      <a class:list={["nav-link", { active: active === 'coaching' }]} href="/coaching/">Coaching &amp; Contact</a>
    </div>
  </nav>

  <slot />

  <footer>
    © {new Date().getFullYear()} Bridge Performance &nbsp;·&nbsp; Dutch Chamber of Commerce (KvK) 63322498 &nbsp;·&nbsp; VAT NL001994665B72
    <div class="footer-links">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms-conditions/">Terms &amp; Conditions</a>
      <a href="/right-of-withdrawal/">Right of Withdrawal</a>
    </div>
  </footer>
</body>
</html>
