---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Message sent | Bridge Performance"
  description="Your inquiry has been sent. Richard Ritmeijer will contact you within 24 hours."
  noindex={true}
>
  <div class="hero" style="padding:56px 32px 48px;">
    <div class="hero-inner">
      <div class="hero-label">Confirmation</div>
      <h1 style="color:white;font-size:34px;">Your inquiry has been sent.</h1>
      <p class="hero-meta">Bridge Performance &nbsp;·&nbsp; Richard Ritmeijer</p>
    </div>
  </div>

  <div class="section">
    <p class="lead">Thank you for your inquiry. I'll get in touch with you <strong>personally within 24 hours</strong> to discuss a tailored proposal.</p>

    <div class="info-box">
      Your own email program has opened (or is opening) with your message already filled in — go ahead and send that email, and your inquiry will reach me. Nothing opened? Email me directly at <a href="mailto:info@bridgeperformance.nl">info@bridgeperformance.nl</a>.
    </div>

    <div class="hero-actions" style="margin-top:28px;">
      <a class="btn-gold" href="/">Back to the homepage</a>
      <a class="btn-ghost" href="/about/">My story</a>
    </div>
  </div>
</Layout>
